{
  "name": "fee-shares-minter-workflow",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "simulate:devnet": "cre workflow simulate ./fee-shares-minter/offchain --project-root=../.. --env=../../../.env --target=devnet-settings --non-interactive --trigger-index=0",
    "simulate:production": "cre workflow simulate ./fee-shares-minter/offchain --project-root=../.. --env=../../../.env --target=production-settings --non-interactive --trigger-index=0",
    "deploy:devnet": "cre workflow deploy ./fee-shares-minter/offchain --project-root=../.. --env=../../../.env --target=devnet-settings",
    "deploy:production": "cre workflow deploy ./fee-shares-minter/offchain --project-root=../.. --env=../../../.env --target=production-settings"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@chainlink/cre-sdk": "1.6.0",
    "viem": "2.48.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "npm": ">=11"
  }
}
