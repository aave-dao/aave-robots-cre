# Enforce that every installed package version has been available on the
# registry for at least 30 days. Requires npm >= 11 (`min-release-age` was
# added there). Value is in days.
min-release-age=30

# All installs must pin exact versions (no ^ / ~).
save-exact=true

# Refuse to install on engine mismatch and use the lockfile as the source of
# truth.
engine-strict=true
package-lock=true
